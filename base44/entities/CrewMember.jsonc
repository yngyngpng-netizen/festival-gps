{
  "name": "CrewMember",
  "type": "object",
  "title": "Crew Member",
  "description": "A festival friend in a shared group with profile pin, group code, and parsed schedule.",
  "properties": {
    "userId": {
      "type": "string",
      "maxLength": 120
    },
    "groupCode": {
      "type": "string",
      "maxLength": 24
    },
    "groupName": {
      "type": "string",
      "description": "Manager-edited display name for the group.",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "email": {
      "type": "string",
      "maxLength": 160
    },
    "pinHash": {
      "type": "string",
      "description": "Client-side hashed 4-6 digit PIN for name + group recovery.",
      "maxLength": 220
    },
    "pinSalt": {
      "type": "string",
      "maxLength": 80
    },
    "photo": {
      "type": "string",
      "maxLength": 800000
    },
    "color": {
      "type": "string",
      "maxLength": 16
    },
    "isGroupOwner": {
      "type": "boolean",
      "default": false
    },
    "createdAt": {
      "type": "string"
    },
    "removedAt": {
      "type": "string"
    },
    "removedBy": {
      "type": "string",
      "maxLength": 120
    },
    "schedule": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120
          },
          "artist": {
            "type": "string",
            "maxLength": 160
          },
          "stageId": {
            "type": "string",
            "maxLength": 40
          },
          "day": {
            "type": "string",
            "enum": ["friday", "saturday", "sunday"]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000
          }
        },
        "required": ["artist", "stageId", "day", "start", "end"]
      }
    },
    "liveLocation": {
      "type": "object",
      "description": "Fresh phone GPS location projected onto the EDC map. Schedule is used when this is missing or stale.",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accuracy": {
          "type": "number",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "maxLength": 24
        },
        "stageId": {
          "type": "string",
          "maxLength": 40
        }
      }
    }
  },
  "required": ["userId", "groupCode", "name"],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": false
  }
}
