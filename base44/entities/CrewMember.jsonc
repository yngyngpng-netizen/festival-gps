{
  "name": "CrewMember",
  "type": "object",
  "title": "Crew Member",
  "description": "A festival friend in a shared group with profile pin, group code, and parsed schedule.",
  "properties": {
    "userId": {
      "type": "string",
      "maxLength": 120
    },
    "groupCode": {
      "type": "string",
      "maxLength": 24
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 160
    },
    "photo": {
      "type": "string",
      "maxLength": 800000
    },
    "color": {
      "type": "string",
      "maxLength": 16
    },
    "schedule": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120
          },
          "artist": {
            "type": "string",
            "maxLength": 160
          },
          "stageId": {
            "type": "string",
            "maxLength": 40
          },
          "day": {
            "type": "string",
            "enum": ["friday", "saturday", "sunday"]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000
          }
        },
        "required": ["artist", "stageId", "day", "start", "end"]
      }
    }
  },
  "required": ["userId", "groupCode", "name"],
  "rls": {
    "create": true,
    "read": {
      "data.groupCode": "{{user.data.festivalGroupCode}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
